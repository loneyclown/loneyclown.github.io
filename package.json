{
  "name": "hexo-blog",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build": "npm run build:css && hexo generate",
    "build:css": "tailwindcss -i ./themes/scifi/source/css/tailwind.css -o ./themes/scifi/source/css/tailwind-compiled.css --minify",
    "clean": "hexo clean",
    "deploy": "hexo deploy",
    "server": "npm run build:css && hexo server",
    "watch:css": "tailwindcss -i ./themes/scifi/source/css/tailwind.css -o ./themes/scifi/source/css/tailwind-compiled.css --watch"
  },
  "hexo": {
    "version": "8.1.2"
  },
  "dependencies": {
    "hexo": "^8.0.0",
    "hexo-blog-encrypt": "^3.1.6",
    "hexo-browsersync": "^0.3.0",
    "hexo-deployer-git": "^3.0.0",
    "hexo-filter-mathjax": "^0.5.3",
    "hexo-generator-archive": "^2.0.0",
    "hexo-generator-category": "^2.0.0",
    "hexo-generator-index": "^3.0.0",
    "hexo-generator-searchdb": "^1.4.0",
    "hexo-generator-tag": "^1.0.0",
    "hexo-render-pug": "^2.1.4",
    "hexo-renderer-ejs": "^2.0.0",
    "hexo-renderer-marked": "^6.1.1",
    "hexo-renderer-pug": "^3.0.0",
    "hexo-renderer-stylus": "^2.1.0",
    "hexo-server": "^3.0.0",
    "hexo-util": "^3.0.1",
    "hexo-wordcount": "^6.0.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.23",
    "hexo-renderer-ts": "^1.3.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19"
  }
}
