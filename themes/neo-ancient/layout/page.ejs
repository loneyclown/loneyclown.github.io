<div class="page-container max-w-3xl mx-auto px-4 py-8">
  <article id="page" class="cyber-card p-6">
    <header class="mb-6">
      <h1 class="text-3xl font-bold cyber-gradient-text"><%= page.title %></h1>
      <% if (page.date) { %>
      <time datetime="<%= date(page.date, 'YYYY-MM-DDTHH:mm:ssZ') %>" class="text-sm text-cyber-gray block mt-2">
        <%= date(page.date, 'YYYY-MM-DD') %>
      </time>
      <% } %>
    </header>
    <div class="cyber-prose">
      <%- page.content %>
    </div>
  </article>
</div>
