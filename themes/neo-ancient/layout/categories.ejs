<div class="category-container max-w-4xl mx-auto px-4 py-8">
  <header class="mb-8">
    <h1 class="text-3xl font-bold cyber-gradient-text mb-2">
      <span class="text-cyber-gold">//</span> 分类
    </h1>
    <p class="text-cyber-gray text-sm">共 <%= site.categories.length %> 个分类</p>
  </header>

  <% if (page.category) { %>
    <div class="mb-8">
      <h2 class="text-2xl font-bold mb-4 flex items-center gap-2">
        <span class="cyber-dot"></span>
        <%= page.category %>
        <span class="text-cyber-gray text-sm font-normal">
          (<%= page.posts.length %> 篇)
        </span>
      </h2>

      <div class="space-y-4">
        <% page.posts.each(function(post) { %>
        <div class="cyber-card p-4 flex flex-col sm:flex-row sm:items-center gap-3">
          <time datetime="<%= date(post.date, 'YYYY-MM-DDTHH:mm:ssZ') %>"
                class="text-cyber-cyan/60 font-mono text-sm whitespace-nowrap">
            <%= date(post.date, 'YYYY-MM-DD') %>
          </time>
          <a href="<%= url_for(post.path) %>" class="cyber-link-title flex-1"><%= post.title %></a>
        </div>
        <% }) %>
      </div>
    </div>

    <%- partial('_partial/pagination') %>

  <% } else { %>
    <div class="category-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
      <% site.categories.each(function(cat) { %>
      <a href="<%= url_for(cat.path) %>" class="cyber-card p-5 text-center group">
        <div class="text-3xl mb-2">📁</div>
        <h3 class="text-lg font-bold cyber-link-title"><%= cat.name %></h3>
        <p class="text-cyber-gray text-sm mt-1"><%= cat.posts.length %> 篇文章</p>
      </a>
      <% }) %>
    </div>
  <% } %>
</div>
