extends includes/layout.pug

block content
  .posts-container.max-w-5xl.mx-auto.px-5.py-8
    if page.posts && page.posts.length > 0
      each post in page.posts.toArray()
        article.post-card.mb-6.group
          .post-header.mb-3
            h2.post-title.text-2xl.font-semibold.mb-2
              a.text-text-primary.hover:text-cyber-cyan.transition-all.duration-300(href=url_for(post.path), class="hover:drop-shadow-[0_0_10px_rgba(0,217,255,0.5)]")
                = post.title
            if theme.post && theme.post.date
              time.post-date.text-text-secondary.text-sm(datetime=post.date.toISOString())
                = date(post.date, 'YYYY-MM-DD')
          
          if post.excerpt
            .post-excerpt.text-text-secondary.mt-3.line-clamp-3
              != post.excerpt
          
          .post-footer.flex.flex-wrap.gap-3.mt-4.pt-4.border-t.border-cyber-cyan.border-opacity-10
            if post.categories && post.categories.length > 0
              .post-categories.flex.flex-wrap.gap-2
                each category in post.categories.toArray()
                  a.category-tag.inline-block.px-3.py-1.text-sm.rounded-full.bg-cyber-cyan.bg-opacity-10.border.border-cyber-cyan.border-opacity-30.text-cyber-cyan.transition-all.duration-300(href=url_for(category.path), class="hover:bg-opacity-20 hover:border-opacity-50 hover:shadow-[0_0_10px_rgba(0,217,255,0.3)]")
                    = category.name
            if post.tags && post.tags.length > 0
              .post-tags.flex.flex-wrap.gap-2
                each tag in post.tags.toArray()
                  a.tag.inline-block.px-3.py-1.text-sm.rounded-full.bg-cyber-cyan.bg-opacity-10.border.border-cyber-cyan.border-opacity-30.text-cyber-cyan.transition-all.duration-300(href=url_for(tag.path), class="hover:bg-opacity-20 hover:border-opacity-50 hover:shadow-[0_0_10px_rgba(0,217,255,0.3)]")
                    = tag.name
            a.read-more.ml-auto.text-cyber-cyan.font-medium.transition-all.duration-300(href=url_for(post.path), class="hover:text-cyber-blue hover:drop-shadow-[0_0_8px_rgba(0,217,255,0.5)]")
              | 阅读更多 →
    
    else
      .empty-state.text-center.py-16.text-text-secondary
        p 暂无文章
    
    if page.total > 1
      .pagination.flex.justify-center.gap-4.mt-8
        != paginator({prev_text: '← 上一页', next_text: '下一页 →'})

