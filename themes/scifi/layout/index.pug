extends includes/layout.pug

block content
  .posts-container.max-w-5xl.mx-auto.px-5.py-8
    if page.posts && page.posts.length > 0
      each post in page.posts.toArray()
        article.scifi-card.mb-6
          .post-header.mb-4
            h2.post-title.text-2xl.font-bold.mb-2
              a.scifi-link(href=url_for(post.path))= post.title
            if theme.post && theme.post.date
              time.post-date.text-gray-400.text-sm(datetime=post.date.toISOString())
                = date(post.date, 'YYYY-MM-DD')
          
          if post.excerpt
            .post-excerpt.text-gray-300.mb-4.line-clamp-3
              != post.excerpt
          
          .post-footer(class="flex flex-wrap items-center gap-3 pt-4 border-t border-scifi-cyan/10")
            if post.categories && post.categories.length > 0
              .post-categories.flex.flex-wrap.gap-2
                each category in post.categories.toArray()
                  a.category-tag(class="inline-block px-3 py-1 bg-scifi-cyan/10 border border-scifi-cyan/30 rounded-full text-sm text-scifi-cyan hover:bg-scifi-cyan/20 hover:shadow-glow transition-all", href=url_for(category.path))= category.name
            if post.tags && post.tags.length > 0
              .post-tags.flex.flex-wrap.gap-2
                each tag in post.tags.toArray()
                  a.tag(class="inline-block px-3 py-1 bg-scifi-purple/10 border border-scifi-purple/30 rounded-full text-sm text-scifi-purple hover:bg-scifi-purple/20 hover:shadow-glow transition-all", href=url_for(tag.path))= tag.name
            a.read-more.ml-auto.scifi-link.font-medium(href=url_for(post.path)) 阅读更多 →
    
    else
      .empty-state.text-center.py-12.text-gray-400
        p 暂无文章
    
    if page.total > 1
      .pagination.flex.justify-center.gap-4.mt-8
        != paginator({prev_text: '← 上一页', next_text: '下一页 →'})
