doctype html
html(lang=config.language)
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    meta(name='generator', content='Hexo')
    title
      if page.title
        = page.title + ' | '
      = config.title
    if config.description
      meta(name='description', content=config.description)
    if config.keywords
      meta(name='keywords', content=config.keywords)
    if config.author
      meta(name='author', content=config.author)
    
    //- Favicon
    if theme.site.logo
      link(rel='icon', href=url_for(theme.site.logo))
    
    //- Stylesheets
    link(rel='stylesheet', href=url_for('/css/tailwind-compiled.css'))
    link(rel='stylesheet', href=url_for('/css/scifi.css'))
    if theme.custom_css
      each css in theme.custom_css
        link(rel='stylesheet', href=url_for(css))
  
  body.bg-scifi-bg.text-gray-200.scifi-scrollbar
    //- 粒子背景画布
    if theme.animation && theme.animation.particles
      canvas#particles-canvas
    
    //- 网格背景
    .fixed.inset-0.scifi-grid-bg.pointer-events-none.z-0
    
    #app.relative.z-10
      include header.pug
      
      main#main.min-h-screen
        block content
      
      footer#footer(class="bg-scifi-bg-secondary border-t border-scifi-cyan/30 mt-12 py-8")
        .footer-content.max-w-7xl.mx-auto.px-5.text-center.text-gray-400.text-sm
          p
            | © #{new Date().getFullYear()} 
            = config.author || config.title
            | . Powered by 
            a.scifi-link(href='https://hexo.io', target='_blank', rel='noopener') Hexo
            |  & 
            a.scifi-link(href='#', target='_blank', rel='noopener') Scifi Theme
    
    //- Scripts
    if theme.animation && theme.animation.particles
      script(src=url_for('/js/particles.js'))
    script(src=url_for('/js/main.js'))
    if theme.custom_js
      each js in theme.custom_js
        script(src=url_for(js))
