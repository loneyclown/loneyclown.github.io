@import 'variables'

// 卡片样式 - 使用 TailwindCSS 增强
.post-card, .archive-item
  background $bg-card
  border 1px solid $border-color
  border-radius 12px
  padding $spacing-unit
  margin-bottom $spacing-unit
  transition all $transition
  backdrop-filter blur(10px)
  position relative
  overflow hidden
  
  // 发光边框效果
  &::before
    content ''
    position absolute
    top 0
    left 0
    right 0
    bottom 0
    border-radius 12px
    padding 1px
    background linear-gradient(135deg, $accent-cyan, $accent-purple, $accent-cyan)
    -webkit-mask linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0)
    -webkit-mask-composite xor
    mask-composite exclude
    opacity 0
    transition opacity $transition
  
  &:hover
    border-color $accent-cyan
    box-shadow 0 0 40px rgba(0, 217, 255, 0.4), 0 0 80px rgba(0, 217, 255, 0.2)
    transform translateY(-4px) scale(1.02)
    
    &::before
      opacity 1

.post-header
  margin-bottom ($spacing-unit / 2)

.post-title
  font-size 1.5rem
  margin-bottom ($spacing-unit / 2)
  
  a
    color $text-primary
    transition all $transition
    
    &:hover
      color $accent-cyan
      text-shadow 0 0 10px rgba(0, 217, 255, 0.5)

.post-date
  color $text-secondary
  font-size 0.9rem

.post-excerpt
  color $text-secondary
  margin ($spacing-unit / 2) 0
  line-height 1.8

.post-footer
  display flex
  flex-wrap wrap
  gap ($spacing-unit / 2)
  margin-top $spacing-unit
  padding-top $spacing-unit
  border-top 1px solid rgba(0, 217, 255, 0.1)

// 标签和分类样式
.category-tag, .tag
  display inline-block
  padding 4px 12px
  background rgba(0, 217, 255, 0.1)
  border 1px solid $border-color
  border-radius 20px
  font-size 0.85rem
  color $accent-cyan
  transition all $transition
  
  &:hover
    background rgba(0, 217, 255, 0.2)
    border-color $accent-cyan
    box-shadow 0 0 10px rgba(0, 217, 255, 0.3)

.post-categories, .post-tags
  display flex
  flex-wrap wrap
  gap ($spacing-unit / 2)

.read-more
  margin-left auto
  color $accent-cyan
  font-weight 500

// 分页样式
.pagination
  display flex
  justify-content center
  gap $spacing-unit
  margin ($spacing-unit * 2) 0

.pagination-link
  padding ($spacing-unit / 2) $spacing-unit
  background $bg-card
  border 1px solid $border-color
  border-radius 6px
  transition all $transition
  
  &:hover
    border-color $accent-cyan
    background rgba(0, 217, 255, 0.1)
    box-shadow 0 0 15px rgba(0, 217, 255, 0.2)

// 空状态
.empty-state
  text-align center
  padding ($spacing-unit * 3)
  color $text-secondary

// 搜索框
.search-box
  position relative
  
  #search-input
    background $bg-card
    border 1px solid $border-color
    border-radius 6px
    padding ($spacing-unit / 2) $spacing-unit
    color $text-primary
    width 200px
    transition all $transition
    
    &:focus
      outline none
      border-color $accent-cyan
      box-shadow 0 0 15px rgba(0, 217, 255, 0.2)
      
    &::placeholder
      color $text-muted

#search-result
  position absolute
  top 100%
  left 0
  right 0
  background $bg-card
  border 1px solid $border-color
  border-radius 6px
  margin-top 4px
  max-height 400px
  overflow-y auto
  display none
  z-index 1000
  box-shadow 0 4px 20px rgba(0, 0, 0, 0.3)
  
  &.show
    display block
  
  .search-result-item
    display block
    padding $spacing-unit
    border-bottom 1px solid rgba(0, 217, 255, 0.1)
    transition all $transition
    
    &:hover
      background rgba(0, 217, 255, 0.1)
    
    &:last-child
      border-bottom none
    
    h4
      margin-bottom ($spacing-unit / 2)
      color $accent-cyan
      font-size 1rem
    
    p
      color $text-secondary
      font-size 0.9rem
      margin 0
  
  .no-result
    padding $spacing-unit
    text-align center
    color $text-secondary

