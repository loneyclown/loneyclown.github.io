// 科幻主题变量定义

// 颜色系统
$bg-primary = #0a0e27      // 主背景色（深蓝黑）
$bg-secondary = #0d1117   // 次要背景色
$bg-card = rgba(13, 17, 23, 0.8)  // 卡片背景

$text-primary = #e0e0e0   // 主文字色
$text-secondary = #a0a0a0 // 次要文字色
$text-muted = #666        // 弱化文字色

$accent-cyan = #00d9ff     // 青色强调
$accent-blue = #0099ff     // 蓝色强调
$accent-purple = #9d4edd   // 紫色强调
$accent-green = #00ff88   // 绿色强调

$border-color = rgba(0, 217, 255, 0.3)  // 边框色
$glow-color = #00d9ff     // 发光色

// 字体
$font-family = -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif
$font-mono = "JetBrains Mono", "Fira Code", "Consolas", monospace

// 尺寸
$container-width = 1200px
$content-width = 800px
$spacing-unit = 20px

// 断点
$mobile = 768px
$tablet = 1024px

// 动画
$transition = 0.3s ease
$glow-intensity = 0 0 10px

