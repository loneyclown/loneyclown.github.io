@import 'variables'

// 响应式设计
@media (max-width $tablet)
  .header-container
    flex-direction column
    gap $spacing-unit
    
  .nav .nav-list
    flex-wrap wrap
    justify-content center

@media (max-width $mobile)
  html
    font-size 14px
  
  h1
    font-size 2rem
  
  h2
    font-size 1.5rem
  
  #main
    padding ($spacing-unit / 2)
  
  .post
    padding ($spacing-unit / 2)
  
  .post-title
    font-size 1.8rem
  
  .post-nav
    flex-direction column
  
  .search-box
    width 100%
    margin-top $spacing-unit
    
    #search-input
      width 100%

