<% if (page.total > 1) { %>
  <nav class="pagination">
    <% if (page.prev) { %>
      <a href="<%- url_for(page.prev_link) %>" class="pagination-prev">
        <i class="fas fa-chevron-left"></i>
        <span>上一页</span>
      </a>
    <% } else { %>
      <span class="pagination-prev disabled">
        <i class="fas fa-chevron-left"></i>
        <span>上一页</span>
      </span>
    <% } %>
    
    <div class="pagination-info">
      <span class="page-current"><%= page.current %></span>
      <span class="page-divider">/</span>
      <span class="page-total"><%= page.total %></span>
    </div>
    
    <% if (page.next) { %>
      <a href="<%- url_for(page.next_link) %>" class="pagination-next">
        <span>下一页</span>
        <i class="fas fa-chevron-right"></i>
      </a>
    <% } else { %>
      <span class="pagination-next disabled">
        <span>下一页</span>
        <i class="fas fa-chevron-right"></i>
      </span>
    <% } %>
  </nav>
<% } %>
